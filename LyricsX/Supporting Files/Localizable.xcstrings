    "Choose your paired phone. Keep your headphones connected to the phone. LyricsX requests song information and playback controls only.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your paired phone. Keep your headphones connected to the phone. LyricsX requests song information and playback controls only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择已配对的手机，耳机继续连接手机。LyricsX 只请求歌曲信息和播放控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇已配對的手機，耳機繼續連接手機。LyricsX 只請求歌曲資訊和播放控制。"
          }
        }
