    "Touch Bar lyrics is not supported in Mac App Store Version. Please download on GitHub." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ظهور الكلمات على شريط اللمس غير مدعومة في إصدار البرنامج المتوفر في متجر تطبيقات Mac. الرجاء التحميل على GitHub."
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "I testi nella Touch Bar non sono supportati nella versione Mac App Store. Scarica da GitHub.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Letras en la Touch Bar no está soportado en la versión de la Mac App Store. Por favor descárgate la versión de GitHub.",
            "state" : "translated"
          }
        },
        "ko" : {
          "stringUnit" : {
            "value" : "터치바 가사 기능은 App Store 버전에서는 지원되지 않습니다. GitHub에서 받아 사용해주세요.",
            "state" : "translated"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst na Touch Bar nie jest dostępny w Wersji z App Store. Aby pobrać, wejdź na GitHub."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Touch Bar songteksten worden niet ondersteund in de Mac App Store versie. Download a.u.b op GitHub.",
            "state" : "translated"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letras na Touch Bar não é suportada na Versão da Loja App Store do Mac. Favor, baixar do GitHub."
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Touch Bar lyrics is not supported in Mac App Store Version. Please download on GitHub.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TouchBar-Songtexte werden nicht in der Mac App Store-Version unterstützt. Bitte laden Sie die entsprechende Version von GitHub herunter."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "value" : "Mac App Store 的版本不支援 Touch Bar 歌詞，請前往 Github 下載。",
            "state" : "translated"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch Bar не поддерживается в версии из Mac App Store. Пожалуйста, скачайте на GitHub."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paroles sur la Touch Bar ne sont pas disponibles dans la version du Mac App Store. Veuillez télécharger la version sur GitHub."
          }
        },
        "id" : {
          "stringUnit" : {
            "value" : "Versi App Store Mac tidak mendukung lirik Batang Sentuh (Touch Bar). Silakan unduh di GitHub.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タッチバーの歌詞は、Mac App Storeのバージョンではサポートされていません。 GitHubから最新バージョンをダウンロードしてください。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "value" : "Touch Bar не підтримується у версії з Mac App Store. Будь ласка, завантажте на GitHub.",
            "state" : "translated"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "value" : "Mac App Store 版不支持触控栏歌词。请从 GitHub 下载最新版本。",
            "state" : "translated"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمایش متن ترانه در تاچ بار در نسخه دانلود شده از فروشگاه اپل پشتیبانی نمی شود. لطفا از نسخه موجود در گیتهاب استفاده کنید."
          }
        }
      },
      "extractionState" : "manual"
    },
